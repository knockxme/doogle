MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=9drive
MYSQL_USER=9drive
MYSQL_PASSWORD=change-this-database-password

FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000

JWT_ACCESS_SECRET=change-this-jwt-secret-at-least-32-chars
TOKEN_ENCRYPTION_KEY=change-this-encryption-key-32bytes!
# REQUIRED. 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing this key makes every stored file permanently unreadable. Keep a copy
# offline, separate from your backups. Never change it on an existing install.
FILE_MASTER_KEY=
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/connected-accounts/google/callback
