# Database passwords: letters and numbers only (openssl rand -hex 24). / : @ # ? % $ break the database address.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=doogle
MYSQL_USER=doogle
MYSQL_PASSWORD=change-this-database-password

FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000

JWT_ACCESS_SECRET=change-this-jwt-secret-at-least-32-chars
TOKEN_ENCRYPTION_KEY=change-this-encryption-key-32bytes!
# REQUIRED. 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing this key makes every stored file permanently unreadable. Keep a copy
# offline, separate from your backups. Never change it on an existing install.
FILE_MASTER_KEY=
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# Largest single file in bytes (5 GB). Raise it for big movies, e.g. 21474836480 for 20 GB.
MAX_UPLOAD_BYTES=5368709120
# Proxies in front of the backend: 1 = only the app container, 2 = with your own HTTPS proxy in front.
TRUST_PROXY_HOPS=1

# WebDAV at /api/dav (for rclone). Only users an admin switched on can use it.
DAV_ENABLED=true
# RAM for decrypted pieces while files are read (MB), and pieces read ahead (8 MB each).
DAV_CACHE_MB=256
DAV_READ_AHEAD=2

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/connected-accounts/google/callback
